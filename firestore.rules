rules_version = '2';

// Exact keys are required. hasAll() requires every field; hasOnly() rejects
// anything else. Empty optional values are stored as null and must be sent.
//
// books nullables: description, isbn13, isbn10, publisher, publishedYear,
//   pageCount, coverUrl, currentPage, progressPercent, startedAt, finishedAt, rating
// readingStatus: want | reading | finished
// Private notes live only in privateNotes. They are not fields on books.
// readingSessions: finishedAt is null unless status is finished.
//   rating is null unless status is finished (then null or 0–5).
// privateNotes nullables: sessionId, page
// settings/currentReading: bookId and sessionId are both null when idle.
//
// Public clients cannot create settings/currentReading. Initialize it once
// with scripts/init-current-reading.mjs before any homepage widget reads it.
// Claim and rules-deploy sequence: scripts/set-admin-claim.mjs
// This file does not deploy itself.

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isIsoString(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$');
    }

    function pointerPath() {
      return /databases/$(database)/documents/settings/currentReading;
    }

    function bookPath(bookId) {
      return /databases/$(database)/documents/books/$(bookId);
    }

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/readingSessions/$(sessionId);
    }

    function validNewsletterCreate(data) {
      return data.keys().hasAll([
          'email', 'firstName', 'subscribedAt', 'isActive', 'source',
          'ipAddress', 'userAgent', 'preferences'
        ])
        && data.keys().hasOnly([
          'email', 'firstName', 'subscribedAt', 'isActive', 'source',
          'ipAddress', 'userAgent', 'preferences'
        ])
        && data.email is string
        && data.email.size() > 3
        && data.email.size() < 320
        && data.email.matches('.*@.*\\..*')
        && data.firstName is string
        && data.firstName.size() < 100
        && data.subscribedAt is timestamp
        && data.isActive == true
        && data.source == 'website'
        && data.ipAddress is string
        && data.ipAddress.size() < 64
        && data.userAgent is string
        && data.userAgent.size() < 500
        && data.preferences.keys().hasAll(['weeklyUpdate', 'newPosts', 'specialOffers'])
        && data.preferences.keys().hasOnly(['weeklyUpdate', 'newPosts', 'specialOffers'])
        && data.preferences.weeklyUpdate is bool
        && data.preferences.newPosts is bool
        && data.preferences.specialOffers is bool;
    }

    function validProgress(progress) {
      return progress.keys().hasAll(['currentPage', 'pageCount', 'percent'])
        && progress.keys().hasOnly(['currentPage', 'pageCount', 'percent'])
        && progress.currentPage is int
        && progress.currentPage >= 0
        && progress.currentPage <= 20000
        && progress.pageCount is int
        && progress.pageCount >= 0
        && progress.pageCount <= 20000
        && (progress.pageCount == 0 || progress.currentPage <= progress.pageCount)
        && progress.percent is number
        && progress.percent >= 0
        && progress.percent <= 100;
    }

    function validBookShape(bookId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'slug', 'title', 'authors', 'sortAuthor', 'description', 'categories',
          'language', 'isbn13', 'isbn10', 'publisher', 'publishedYear', 'pageCount',
          'formats', 'coverUrl', 'visibility', 'readingStatus', 'currentPage',
          'progressPercent', 'startedAt', 'finishedAt', 'rating', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'slug', 'title', 'authors', 'sortAuthor', 'description', 'categories',
          'language', 'isbn13', 'isbn10', 'publisher', 'publishedYear', 'pageCount',
          'formats', 'coverUrl', 'visibility', 'readingStatus', 'currentPage',
          'progressPercent', 'startedAt', 'finishedAt', 'rating', 'createdAt', 'updatedAt'
        ])
        && data.slug == bookId
        && data.title is string
        && data.title.size() > 0
        && data.title.size() < 500
        && data.authors is list
        && data.authors.size() > 0
        && data.authors.size() <= 20
        && data.sortAuthor is string
        && data.sortAuthor.size() < 500
        && (data.description == null || (data.description is string && data.description.size() < 10000))
        && data.categories is list
        && data.categories.size() <= 30
        && data.language is string
        && data.language.size() < 16
        && (data.isbn13 == null || (data.isbn13 is string && data.isbn13.size() < 32))
        && (data.isbn10 == null || (data.isbn10 is string && data.isbn10.size() < 16))
        && (data.publisher == null || (data.publisher is string && data.publisher.size() < 300))
        && (data.publishedYear == null || (data.publishedYear is int && data.publishedYear >= 0 && data.publishedYear <= 2200))
        && (data.pageCount == null || (data.pageCount is int && data.pageCount >= 0 && data.pageCount <= 20000))
        && data.formats is list
        && data.formats.size() <= 4
        && (data.coverUrl == null || (data.coverUrl is string && data.coverUrl.size() < 2000))
        && data.visibility in ['public', 'unlisted']
        && data.readingStatus in ['want', 'reading', 'finished']
        && (data.currentPage == null || (data.currentPage is int && data.currentPage >= 0 && data.currentPage <= 20000))
        && (data.pageCount == null || data.currentPage == null || data.currentPage <= data.pageCount)
        && (data.progressPercent == null || (data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100))
        && (data.startedAt == null || data.startedAt is timestamp)
        && (data.finishedAt == null || data.finishedAt is timestamp)
        && (data.rating == null || (data.rating is int && data.rating >= 0 && data.rating <= 5))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function bookIsNotCurrent(bookId) {
      return !existsAfter(pointerPath())
        || getAfter(pointerPath()).data.bookId != bookId;
    }

    function pointerAgrees(sessionId) {
      let pointerExists = existsAfter(pointerPath());
      let projected = pointerExists ? getAfter(pointerPath()) : null;

      return request.resource.data.status == 'reading'
        || !pointerExists
        || projected.data.sessionId != sessionId;
    }

    function validRating(data) {
      return data.rating == null
        || (data.rating is int && data.rating >= 0 && data.rating <= 5);
    }

    function validSessionShape(sessionId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'bookId', 'title', 'authors', 'bookVisibility', 'status', 'startedAt',
          'finishedAt', 'progress', 'rating', 'format', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookId', 'title', 'authors', 'bookVisibility', 'status', 'startedAt',
          'finishedAt', 'progress', 'rating', 'format', 'createdAt', 'updatedAt'
        ])
        && data.bookId is string
        && data.bookId.size() > 0
        && data.bookId.size() < 200
        && data.title is string
        && data.title.size() > 0
        && data.title.size() < 500
        && data.authors is list
        && data.authors.size() > 0
        && data.authors.size() <= 20
        && data.bookVisibility in ['public', 'unlisted']
        && data.status in ['reading', 'paused', 'finished', 'abandoned']
        && data.startedAt is timestamp
        && (
          (data.status == 'finished' && data.finishedAt is timestamp)
          || (data.status != 'finished' && data.finishedAt == null)
        )
        && validProgress(data.progress)
        && validRating(data)
        && data.format in ['digital', 'physical', 'audio']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && pointerAgrees(sessionId);
    }

    function snapshotMatchesBook() {
      let book = getAfter(bookPath(request.resource.data.bookId));
      return book != null
        && book.data.slug == request.resource.data.bookId
        && book.data.title == request.resource.data.title
        && book.data.authors == request.resource.data.authors
        && book.data.visibility == request.resource.data.bookVisibility;
    }

    function validPointerShape(data) {
      return data.keys().hasAll(['bookId', 'sessionId', 'updatedAt'])
        && data.keys().hasOnly(['bookId', 'sessionId', 'updatedAt'])
        && data.updatedAt is timestamp
        && (
          (data.bookId == null && data.sessionId == null)
          || (
            data.bookId is string && data.bookId.size() > 0 && data.bookId.size() < 200
            && data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() < 200
          )
        );
    }

    function pointerTargetsReadingSession(data) {
      let projected = data.sessionId == null ? null : getAfter(sessionPath(data.sessionId));
      return data.sessionId == null
        || (
          projected != null
          && projected.data.status == 'reading'
          && projected.data.bookId == data.bookId
        );
    }

    function previousSessionReleased() {
      let previousId = resource.data.sessionId;
      let projected = previousId == null ? null : getAfter(sessionPath(previousId));
      return previousId == null
        || previousId == request.resource.data.sessionId
        || (projected != null && projected.data.status != 'reading');
    }

    function validPrivateNote() {
      let data = request.resource.data;
      return data.keys().hasAll(['bookId', 'sessionId', 'kind', 'body', 'page', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['bookId', 'sessionId', 'kind', 'body', 'page', 'createdAt', 'updatedAt'])
        && data.bookId is string
        && data.bookId.size() > 0
        && data.bookId.size() < 200
        && (data.sessionId == null || (data.sessionId is string && data.sessionId.size() < 200))
        && data.kind in ['note', 'quotation']
        && data.body is string
        && data.body.size() > 0
        && data.body.size() < 20000
        && (data.page == null || (data.page is int && data.page >= 0 && data.page <= 20000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function publicBook(bookId) {
      let book = get(bookPath(bookId));
      return book != null && book.data.visibility == 'public';
    }

    function publicReadingSession(sessionId, bookId) {
      let session = get(sessionPath(sessionId));
      return session != null
        && session.data.status == 'reading'
        && session.data.bookVisibility == 'public'
        && session.data.bookId == bookId;
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if validNewsletterCreate(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'unsubscribedAt'])
        && request.resource.data.isActive == false
        && request.resource.data.unsubscribedAt is timestamp;
      allow delete: if false;
    }

    match /articles/{articleSlug} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['views', 'firstViewed', 'lastViewed', 'slug'])
        && request.resource.data.keys().hasOnly(['views', 'firstViewed', 'lastViewed', 'slug'])
        && articleSlug.size() > 0
        && articleSlug.size() < 200
        && request.resource.data.slug == articleSlug
        && request.resource.data.views == 1
        && isIsoString(request.resource.data.firstViewed)
        && isIsoString(request.resource.data.lastViewed);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'lastViewed', 'slug'])
        && resource.data.views is int
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.slug == articleSlug
        && isIsoString(request.resource.data.lastViewed);
      allow delete: if false;
    }

    match /commentCounts/{postSlug} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /presence/owner {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen is timestamp;
      allow delete: if false;
    }

    match /networth/holdings {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /dashboard/main {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /books/{bookId} {
      allow read: if isAdmin() || resource.data.visibility == 'public';
      allow create: if isAdmin() && validBookShape(bookId);
      allow update: if isAdmin()
        && validBookShape(bookId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.slug == bookId
        && (
          !resource.data.keys().hasAny(['slug'])
          || resource.data.slug == request.resource.data.slug
        );
      allow delete: if isAdmin() && bookIsNotCurrent(bookId);
    }

    match /readingSessions/{sessionId} {
      allow read: if isAdmin() || resource.data.bookVisibility == 'public';
      allow create: if isAdmin() && validSessionShape(sessionId) && snapshotMatchesBook();
      allow update: if isAdmin()
        && validSessionShape(sessionId)
        && request.resource.data.bookId == resource.data.bookId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin()
        && (
          !existsAfter(pointerPath())
          || getAfter(pointerPath()).data.sessionId != sessionId
        );
    }

    match /settings/currentReading {
      allow get: if isAdmin()
        || (
          resource.data.bookId == null
          && resource.data.sessionId == null
        )
        || (
          resource.data.bookId is string
          && resource.data.sessionId is string
          && publicBook(resource.data.bookId)
          && publicReadingSession(resource.data.sessionId, resource.data.bookId)
        );
      allow list: if false;
      allow create: if isAdmin()
        && validPointerShape(request.resource.data)
        && pointerTargetsReadingSession(request.resource.data);
      allow update: if isAdmin()
        && validPointerShape(request.resource.data)
        && previousSessionReleased()
        && pointerTargetsReadingSession(request.resource.data);
      allow delete: if false;
    }

    match /privateNotes/{noteId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validPrivateNote();
      allow update: if isAdmin()
        && validPrivateNote()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // Gallery. These blocks do not apply to books, readingSessions, or privateNotes.
    // Public clients may read a photo or album only when its status is published.
    // Photo binaries are not stored here. Deleting a photo document from the client
    // is refused so Cloudinary cleanup stays on the signed server function.
    // Library isAdmin() does not grant gallery access. The ID token must carry
    // galleryOwner == true (boolean) and email_verified == true. Assign the claim
    // with scripts/set-gallery-owner-claim.mjs, then sign out and in. This file
    // does not deploy itself and does not write the claim.
    function isGalleryOwner() {
      return request.auth != null
        && request.auth.token.galleryOwner == true
        && request.auth.token.email_verified == true;
    }

    function galleryPhotoId(photoId) {
      return photoId.matches('^[A-Za-z0-9]{20,32}$');
    }

    function galleryPublicId(photoId) {
      return 'mohamedshams/gallery/' + photoId;
    }

    function optionalText(value, max) {
      return value == null || (value is string && value.size() > 0 && value.size() <= max);
    }

    function validTag(value) {
      return value is string && value.size() > 0 && value.size() <= 40;
    }

    function validTags(tags) {
      return tags is list
        && tags.size() <= 10
        && (tags.size() < 1 || validTag(tags[0]))
        && (tags.size() < 2 || validTag(tags[1]))
        && (tags.size() < 3 || validTag(tags[2]))
        && (tags.size() < 4 || validTag(tags[3]))
        && (tags.size() < 5 || validTag(tags[4]))
        && (tags.size() < 6 || validTag(tags[5]))
        && (tags.size() < 7 || validTag(tags[6]))
        && (tags.size() < 8 || validTag(tags[7]))
        && (tags.size() < 9 || validTag(tags[8]))
        && (tags.size() < 10 || validTag(tags[9]));
    }

    function validPhoto(photoId) {
      let data = request.resource.data;
      return galleryPhotoId(photoId)
        && data.keys().hasAll([
          'id', 'publicId', 'secureUrl', 'originalFormat', 'width', 'height', 'bytes',
          'caption', 'description', 'albumId', 'tags', 'location', 'takenAt',
          'uploadedAt', 'status', 'sortOrder'
        ])
        && data.keys().hasOnly([
          'id', 'publicId', 'secureUrl', 'originalFormat', 'width', 'height', 'bytes',
          'caption', 'description', 'albumId', 'tags', 'location', 'takenAt',
          'uploadedAt', 'status', 'sortOrder'
        ])
        && data.id == photoId
        && data.publicId == galleryPublicId(photoId)
        && data.secureUrl is string
        && data.secureUrl.size() < 500
        && data.secureUrl.matches('^https://res\\.cloudinary\\.com/[a-z0-9-]+/image/upload/.+')
        && data.originalFormat is string
        && data.originalFormat.matches('^[a-z0-9]{3,5}$')
        && data.width is int
        && data.width > 0
        && data.width <= 30000
        && data.height is int
        && data.height > 0
        && data.height <= 30000
        && data.bytes is int
        && data.bytes > 0
        && data.bytes <= 10485760
        && optionalText(data.caption, 500)
        && optionalText(data.description, 4000)
        && (data.albumId == null || (data.albumId is string && data.albumId.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && data.albumId.size() <= 80))
        && validTags(data.tags)
        && optionalText(data.location, 160)
        && (data.takenAt == null || data.takenAt is timestamp)
        && data.uploadedAt is timestamp
        && data.status in ['draft', 'published', 'archived']
        && data.sortOrder is int
        && data.sortOrder >= 0;
    }

    function photoIdentityUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.publicId == resource.data.publicId
        && request.resource.data.secureUrl == resource.data.secureUrl
        && request.resource.data.originalFormat == resource.data.originalFormat
        && request.resource.data.width == resource.data.width
        && request.resource.data.height == resource.data.height
        && request.resource.data.bytes == resource.data.bytes
        && request.resource.data.uploadedAt == resource.data.uploadedAt;
    }

    function photoStatusStep() {
      return request.resource.data.status == resource.data.status
        || (resource.data.status == 'draft' && request.resource.data.status in ['published', 'archived'])
        || (resource.data.status == 'published' && request.resource.data.status in ['draft', 'archived'])
        || (resource.data.status == 'archived' && request.resource.data.status == 'draft');
    }

    function validAlbum(albumId) {
      let data = request.resource.data;
      return albumId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && albumId.size() >= 2
        && albumId.size() <= 80
        && data.keys().hasAll([
          'id', 'title', 'slug', 'description', 'coverPhotoId',
          'createdAt', 'updatedAt', 'status', 'sortOrder'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'slug', 'description', 'coverPhotoId',
          'createdAt', 'updatedAt', 'status', 'sortOrder'
        ])
        && data.id == albumId
        && data.slug == albumId
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && optionalText(data.description, 4000)
        && (data.coverPhotoId == null || (data.coverPhotoId is string && galleryPhotoId(data.coverPhotoId)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.status in ['draft', 'published', 'archived']
        && data.sortOrder is int
        && data.sortOrder >= 0;
    }

    function albumIdentityUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function albumStatusStep() {
      return request.resource.data.status == resource.data.status
        || (resource.data.status == 'draft' && request.resource.data.status in ['published', 'archived'])
        || (resource.data.status == 'published' && request.resource.data.status in ['draft', 'archived'])
        || (resource.data.status == 'archived' && request.resource.data.status == 'draft');
    }

    function validCleanup(cleanupId) {
      let data = request.resource.data;
      return galleryPhotoId(cleanupId)
        && data.keys().hasAll([
          'photoId', 'publicId', 'secureUrl', 'originalFormat', 'width', 'height',
          'bytes', 'reason', 'createdAt'
        ])
        && data.keys().hasOnly([
          'photoId', 'publicId', 'secureUrl', 'originalFormat', 'width', 'height',
          'bytes', 'reason', 'createdAt'
        ])
        && data.photoId == cleanupId
        && data.publicId == galleryPublicId(cleanupId)
        && data.secureUrl is string
        && data.secureUrl.size() < 500
        && data.originalFormat is string
        && data.originalFormat.size() <= 8
        && data.width is int
        && data.width >= 0
        && data.width <= 30000
        && data.height is int
        && data.height >= 0
        && data.height <= 30000
        && data.bytes is int
        && data.bytes >= 0
        // Photo documents stay capped at 10 MB. Cleanup may record a larger
        // Cloudinary-reported size so an oversized upload can be deleted later.
        && data.bytes <= 209715200
        && data.reason in ['firestore-write-failed', 'rejected-after-upload']
        && data.createdAt is timestamp;
    }

    match /photos/{photoId} {
      allow read: if isGalleryOwner() || resource.data.status == 'published';
      allow create: if isGalleryOwner()
        && validPhoto(photoId)
        && request.resource.data.status == 'draft';
      allow update: if isGalleryOwner()
        && validPhoto(photoId)
        && photoIdentityUnchanged()
        && photoStatusStep();
      allow delete: if false;
    }

    match /albums/{albumId} {
      allow read: if isGalleryOwner() || resource.data.status == 'published';
      allow create: if isGalleryOwner()
        && validAlbum(albumId)
        && request.resource.data.status in ['draft', 'published'];
      allow update: if isGalleryOwner()
        && validAlbum(albumId)
        && albumIdentityUnchanged()
        && albumStatusStep();
      allow delete: if isGalleryOwner() && resource.data.status == 'archived';
    }

    match /photoCleanup/{cleanupId} {
      allow read: if isGalleryOwner();
      allow create: if isGalleryOwner() && validCleanup(cleanupId);
      allow update: if false;
      allow delete: if isGalleryOwner();
    }
  }
}
