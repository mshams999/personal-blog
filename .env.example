# 🔐 ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file with real values!

# ===========================================
# STORYBLOK CMS
# ===========================================
# Get these from https://app.storyblok.com/ (Space Settings → Access Tokens)
# Use the "Preview" token for draft content, or "Public" for published-only.
VITE_STORYBLOK_TOKEN=your-storyblok-preview-token-here
# 'eu' (default) or 'us' — must match the region your Storyblok space lives in
VITE_STORYBLOK_REGION=eu
# Space ID from Space → Settings → General (admin links in the app)
VITE_STORYBLOK_SPACE_ID=your-space-id-here

# ===========================================
# SITE CONFIGURATION
# ===========================================
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# ===========================================
# GOOGLE ANALYTICS
# ===========================================
# Get from Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# MAILCHIMP CONFIGURATION
# ===========================================
# Get from your Mailchimp account
VITE_MAILCHIMP_API_KEY=your-api-key-here
VITE_MAILCHIMP_SERVER_PREFIX=us10
VITE_MAILCHIMP_AUDIENCE_ID=your-audience-id-here
VITE_MAILCHIMP_SIGNUP_URL=your-signup-url-here

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================
# Get from Firebase Console > Project Settings > Web App
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id-here
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
VITE_FIREBASE_APP_ID=your-app-id-here
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Library reads and writes use the Firebase project above, including `npm run dev`.
# Set the emulator flag to exactly "true" only for an optional local emulator test.
# Production builds ignore the flag. Do not set it for normal development.
# VITE_FIRESTORE_EMULATOR=false
# VITE_FIRESTORE_EMULATOR_HOST=localhost
# VITE_FIRESTORE_EMULATOR_PORT=8080
# Used only when the emulator flag is exactly "true".
# VITE_FIRESTORE_EMULATOR_PROJECT=demo-reading-library
# Google Books is not a frontend variable. When the lookup function is deployed,
# store the key as the Functions secret GOOGLE_BOOKS_API_KEY and restrict it to the Books API.

# ===========================================
# PHOTO GALLERY (Cloudinary)
# ===========================================
# PUBLIC. Vite inlines every VITE_ variable into the browser bundle.
#   VITE_CLOUDINARY_CLOUD_NAME — cloud name used in delivery URLs
#   VITE_CLOUDINARY_API_KEY — public API key attached to a signed upload
# These two are safe to expose. Do not add any other Cloudinary value with a
# VITE_ prefix. Never create VITE_CLOUDINARY_API_SECRET.
#
# SERVER-ONLY. Set these in the Netlify function environment, or in a local
# .env that the dev server reads. They must never use a VITE_ prefix:
#   CLOUDINARY_API_SECRET
#   FIREBASE_SERVICE_ACCOUNT_JSON
#   GALLERY_OWNER_EMAIL
# If GALLERY_OWNER_EMAIL is missing, gallery signing fails closed (HTTP 500).
# A missing Cloudinary cloud name, API key, or API secret also fails closed.
# A missing Firebase service account fails closed the same way.
#
# VITE_OWNER_EMAIL and GALLERY_OWNER_EMAIL must be the same verified Google
# address. The gallery admin UI reads VITE_OWNER_EMAIL. Netlify functions read
# GALLERY_OWNER_EMAIL. If VITE_OWNER_EMAIL is unset, gallery admin pages stay
# closed. The UI check is not a substitute for the function or Firestore rules.
# Gallery access also requires the boolean custom claim galleryOwner: true
# and email_verified. A generic admin claim is not enough. Set the claim with
# scripts/set-gallery-owner-claim.mjs using a service account that is not
# committed, then sign out and back in. Do not commit that service account.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER_MODE=dynamic
# GALLERY_OWNER_EMAIL=you@example.com
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ===========================================
# DISQUS CONFIGURATION (Optional)
# ===========================================
REACT_APP_DISQUS_SHORTNAME=your-disqus-shortname

# ===========================================
# EMAIL CONFIGURATION (Newsletter Welcome Emails)
# ===========================================
# ✅ DEPLOYED: Resend + Firebase Functions configuration for automatic welcome emails
# Get Resend API key from https://resend.com/
VITE_RESEND_API_KEY=your-resend-api-key-here

# ✅ DEPLOYED FUNCTIONS URL (Update with your project ID)
VITE_FIREBASE_FUNCTIONS_URL=https://us-central1-personal-blog-48d5c.cloudfunctions.net

# Site Information for email templates
VITE_SITE_NAME=Ruki Blog
VITE_SITE_URL=https://yoursite.com
VITE_SENDER_EMAIL=noreply@yoursite.com

# ===========================================
# NET WORTH PAGE (private /net-worth route)
# ===========================================
# Google account email allowed to view the private /net-worth and /admin pages.
# Gallery admin routes also require this to be the same verified Google address
# as the server-only GALLERY_OWNER_EMAIL above. The UI reads this variable.
# Functions read GALLERY_OWNER_EMAIL. If this is unset, gallery admin stays closed.
VITE_OWNER_EMAIL=you@example.com
# Twelve Data API key — https://twelvedata.com/ (free tier ~800 req/day)
VITE_TWELVEDATA_API_KEY=your-twelvedata-api-key-here
# One-time Firestore seed — pick one:
# Admin SDK: place serviceAccountKey.json at repo root, or set GOOGLE_APPLICATION_CREDENTIALS to the key path, then: npm run networth:seed
# Client SDK: npm run networth:seed:client (needs Email/Password auth)
# FIREBASE_SEED_EMAIL=
# FIREBASE_SEED_PASSWORD=

# ===========================================
# OPTIONAL LOCAL LIBRARY EMULATOR
# ===========================================
# Normal development saves the library in the live Firebase project.
# These variables are only for scripts and tests that opt into the emulator.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# VITE_FIRESTORE_EMULATOR=false
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3001
